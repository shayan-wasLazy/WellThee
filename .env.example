# Backend environment
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://wealthos:wealthos@localhost:5432/wealthos
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=10080
FRONTEND_ORIGINS=http://localhost:3000

# Optional LLM explanation layer. Numeric calculations stay deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PayPal Developer Sandbox. Keep credentials server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Next.js reverse-proxy destination
BACKEND_URL=http://localhost:8000
