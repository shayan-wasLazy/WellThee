# Optional overrides read by Docker Compose from this file.
# The default local stack works without creating a .env file.

# Replace this for your own local setup if desired.
JWT_SECRET=wealthos-local-development-secret-change-me
ACCESS_TOKEN_MINUTES=10080

# Optional AI explanation layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional PayPal Developer Sandbox credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
